IPHONEOS_DEPLOYMENT_TARGET = 15.0
PRODUCT_BUNDLE_IDENTIFIER = ink.rea.keytao-app
PRODUCT_NAME = KeyTao
PRODUCT_MODULE_NAME = Runner
CODE_SIGN_STYLE = Automatic
