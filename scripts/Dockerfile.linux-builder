FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse \
    PATH="/opt/flutter/bin:/root/.cargo/bin:$PATH" \
    FLUTTER_SUPPRESS_ANALYTICS=true \
    CI=true

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl file git \
        gcc g++ pkg-config \
        python3 \
        unzip xz-utils zip \
        rpm cpio \
        cmake ninja-build \
        mold \
        clang libclang-dev \
        libgtk-3-dev \
        liblzma-dev libglu1-mesa libegl1 \
        libssl-dev libdbus-1-dev \
        librime-dev \
        librime-plugin-lua \
        libfreetype6-dev \
        libxcb1-dev \
        libxdo-dev \
        libxkbcommon-dev \
        libxkbcommon-x11-dev \
        patchelf \
        xdg-utils \
    && rm -rf /var/lib/apt/lists/* \
    && command -v dpkg-deb dpkg-query rpmbuild rpm2cpio cpio patchelf readelf

# A source checkout lets Flutter select the native x64/arm64 engine artifacts.
ARG FLUTTER_VERSION=3.47.5
RUN git clone --depth 1 --branch "$FLUTTER_VERSION" https://github.com/flutter/flutter.git /opt/flutter \
    && flutter config --no-analytics --enable-linux-desktop \
    && flutter precache --linux \
    && flutter --version

# Install only the Linux host toolchain, not the workspace's mobile targets.
COPY rust-toolchain.toml /tmp/keytao-rust-toolchain.toml
# The apt rustup must be initialized by `rustup default` before other commands.
RUN apt-get update && apt-get install -y --no-install-recommends rustup \
    && rm -rf /var/lib/apt/lists/* \
    && rustup default "$(sed -n 's/^channel = "\(.*\)"/\1/p' /tmp/keytao-rust-toolchain.toml)" \
    && rustup show
