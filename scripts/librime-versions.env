# Stable librime release used by SDK downloads, headers and source builds.
LIBRIME_VERSION=1.17.0
# librime-lua commit verified by the iOS source build.
LIBRIME_LUA_REF=6da5d6cedb853380ed1b5b9b6979cb1a9c028353
# Bundled Lua sources from the librime-lua thirdparty branch for Linux builds.
LIBRIME_LUA_THIRDPARTY_REF=9e5bb71db1544913f8005dadc3df8439c00d08b7
# Android merged plugins, matching fcitx5-android/prebuilder.
LIBRIME_OCTAGRAM_REF=dfcc15115788c828d9dd7b4bff68067d3ce2ffb8
LIBRIME_PREDICT_REF=920bd41ebf6f9bf6855d14fbe80212e54e749791
# fcitx5-android release supplying the rollback runtime plugin APK only.
FCITX5_ANDROID_VERSION=0.1.3
# Actual librime version expected inside the rollback Android plugin APK only.
ANDROID_LIBRIME_EXPECTED=1.16.1
# OpenCC release supplying the Windows portable data archive.
OPENCC_PORTABLE_VERSION=ver.1.4.2
