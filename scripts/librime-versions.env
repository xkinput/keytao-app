# Stable librime release used by SDK downloads, headers and source builds.
LIBRIME_VERSION=1.17.0
# librime-lua commit verified by the iOS source build.
LIBRIME_LUA_REF=6da5d6cedb853380ed1b5b9b6979cb1a9c028353
# fcitx5-android release supplying the Android runtime plugin APK.
FCITX5_ANDROID_VERSION=0.1.3
# Actual librime version expected inside the Android plugin APK.
ANDROID_LIBRIME_EXPECTED=1.16.1
# OpenCC release supplying the Windows portable data archive.
OPENCC_PORTABLE_VERSION=ver.1.4.2
